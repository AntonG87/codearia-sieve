# Dependencies
node_modules/

# Secrets: the vendor key never belongs in the repository
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/

# Local scratch: saved pages used to check the cleaning step. Third-party HTML
# stays on the machine that downloaded it; bench/pages.txt is what gets shared.
fixtures/pages/
bench/pages/
*.local.*

# OS
.DS_Store
Thumbs.db

# Console log of the last analytics run; the rows and the summary are what matter.
bench/analytics/run.log

# Lab runs: scripts and findings are shared, raw results stay local until reviewed
bench/lab/*/results/

# The lab: scenario scripts and notes used to find bugs; stays on the machine
bench/lab/
